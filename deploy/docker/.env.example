# Copy to .env and edit. docker-compose.yml refuses to start without the three
# POSTGRES_* values, deliberately: an unset database setting makes GeoNetwork
# fall back silently to an H2 file rather than fail.
#
# .env is gitignored. Do not put real credentials in .env.example, and do not
# commit .env — this repository is public.
#
# Treat every credential from the 2024 Alibaba deployment as compromised: two
# July 2024 notes in the public usgin/dde-metadata repo carry Elasticsearch
# passwords in plain text. Generate new ones here, for example with
#   openssl rand -base64 24

POSTGRES_DB=geonetwork
POSTGRES_USER=geonetwork
POSTGRES_PASSWORD=CHANGE_ME

# Host port the catalogue is published on. Behind a reverse proxy, bind to
# localhost instead: GN_PORT=127.0.0.1:8080
GN_PORT=8080

# Heap. Defaults suit a host with 8 GB. On 4 GB try -Xms512m -Xmx1g for
# GeoNetwork and -Xms512m -Xmx512m for Elasticsearch; below that, expect
# trouble rather than tuning.
# These two hold a space. Compose reads the value to end of line, which is what
# we want, but `source .env` in a shell would try to run the second word as a
# command. Let Compose read this file; do not source it.
GN_HEAP=-Xms1g -Xmx2g
ES_JAVA_OPTS=-Xms1g -Xmx1g
